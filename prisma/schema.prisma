generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── USER & AUTH ───────────────────────────────

model User {
  id            String    @id @default(cuid())
  phone         String    @unique
  email         String?   @unique
  name          String?
  password      String?
  role          UserRole  @default(BUYER)
  isVerified    Boolean   @default(false)
  nidVerified   Boolean   @default(false)
  profileImage  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  listings      Listing[]
  vehicles      Vehicle[]
  constructions Construction[]
  projects      Project[]
  savedListings SavedListing[]
  reviews       Review[]
  subscription  Subscription?
  otps          OTP[]
  leadsUnlocked LeadUnlock[]
  featuredSlots FeaturedListing[]
  developerProjects DeveloperProject[]
  projects      DeveloperProject[]
}

enum UserRole {
  BUYER
  OWNER
  BROKER
  BUILDER
  ADMIN
}

model OTP {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [phone], references: [phone])
}

// ─── LOCATION ──────────────────────────────────

model Division {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  nameBn    String
  districts District[]
}

model District {
  id         Int       @id @default(autoincrement())
  name       String
  nameBn     String
  division   Division  @relation(fields: [divisionId], references: [id])
  divisionId Int
  upazilas  Upazila[]
  listings   Listing[]
  vehicles   Vehicle[]
  constructions Construction[]
  projects   DeveloperProject[]
  projects      Project[]
}

model Upazila {
  id         Int      @id @default(autoincrement())
  name       String
  nameBn     String
  district   District @relation(fields: [districtId], references: [id])
  districtId Int
  listings   Listing[]
}

// ─── PROPERTY LISTING ──────────────────────────

model Listing {
  id            String        @id @default(cuid())
  title         String
  description   String        @db.Text
  type          ListingType
  purpose       ListingPurpose
  price         Decimal       @db.Decimal(12, 2)
  negotiable    Boolean       @default(false)
  area          Float?        // sqft
  bedrooms      Int?
  bathrooms     Int?
  floor         Int?
  totalFloors   Int?
  facing        String?
  furnished     Boolean       @default(false)
  parking       Boolean       @default(false)
  gasLine       Boolean       @default(false)
  lift          Boolean       @default(false)
  images        ListingImage[]
  address       String
  mapLat        Float?
  mapLng        Float?
  district      District      @relation(fields: [districtId], references: [id])
  districtId    Int
  upazila       Upazila?      @relation(fields: [upazilaId], references: [id])
  upazilaId     Int?
  areaName      String?
  status        ListingStatus @default(PENDING)
  isFeatured    Boolean       @default(false)
  numberVisible  Boolean       @default(false)
  paidListingFee Decimal?     @db.Decimal(8, 2)
  viewCount     Int           @default(0)
  owner         User          @relation(fields: [ownerId], references: [id])
  ownerId       String
  savedBy       SavedListing[]
  leads         LeadUnlock[]
  featuredSlots FeaturedListing[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model ListingImage {
  id        String  @id @default(cuid())
  url       String
  isPrimary Boolean @default(false)
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
}

enum ListingType {
  FLAT
  HOUSE
  SHOP
  OFFICE
  LAND
  BUILDING
  WAREHOUSE
}

enum ListingPurpose {
  SALE
  RENT
}

enum ListingStatus {
  PENDING
  ACTIVE
  SOLD
  RENTED
  REJECTED
  EXPIRED
}

// ─── VEHICLE ───────────────────────────────────

model Vehicle {
  id            String        @id @default(cuid())
  title         String
  description   String        @db.Text
  type          VehicleType
  purpose       VehiclePurpose
  brand         String
  model         String
  year          Int
  price         Decimal       @db.Decimal(12, 2)
  negotiable    Boolean       @default(false)
  mileage       Int?
  condition     VehicleCondition
  color         String?
  fuelType      String?
  transmission  String?
  images        VehicleImage[]
  address       String
  district      District      @relation(fields: [districtId], references: [id])
  districtId    Int
  areaName      String?
  status        ListingStatus @default(PENDING)
  isFeatured    Boolean       @default(false)
  numberVisible  Boolean       @default(false)
  paidListingFee Decimal?     @db.Decimal(8, 2)
  viewCount     Int           @default(0)
  owner         User          @relation(fields: [ownerId], references: [id])
  ownerId       String
  leads         LeadUnlock[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model VehicleImage {
  id        String  @id @default(cuid())
  url       String
  isPrimary Boolean @default(false)
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId String
}

enum VehicleType {
  CAR
  BIKE
}

enum VehiclePurpose {
  SALE
  RENT
}

enum VehicleCondition {
  NEW
  EXCELLENT
  GOOD
  FAIR
}

// ─── CONSTRUCTION ──────────────────────────────

model Construction {
  id           String    @id @default(cuid())
  companyName  String
  description  String    @db.Text
  services     String    @db.Text   // JSON array
  experience   Int       // years
  portfolio    PortfolioItem[]
  district     District  @relation(fields: [districtId], references: [id])
  districtId   Int
  address      String
  coverImage   String?
  status       ListingStatus @default(PENDING)
  isFeatured   Boolean   @default(false)
  owner        User      @relation(fields: [ownerId], references: [id])
  ownerId      String
  reviews      Review[]
  leads        LeadUnlock[]
  projects     DeveloperProject[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ─── DEVELOPER PROJECT ─────────────────────────

model DeveloperProject {
  id              String          @id @default(cuid())
  title           String
  description     String          @db.Text
  projectType     ProjectType     @default(RESIDENTIAL)
  status          ProjectStatus   @default(ONGOING)

  // Location
  address         String
  district        District        @relation(fields: [districtId], references: [id])
  districtId      Int
  areaName        String?
  mapLat          Float?
  mapLng          Float?

  // Project details
  totalUnits      Int
  availableUnits  Int
  floorCount      Int?
  landArea        String?         // e.g. "10 katha"
  handoverDate    DateTime?
  startDate       DateTime?

  // Pricing
  pricePerSqft    Decimal?        @db.Decimal(10, 2)
  minPrice        Decimal         @db.Decimal(12, 2)
  maxPrice        Decimal         @db.Decimal(12, 2)

  // Media
  coverImage      String?
  images          ProjectImage[]
  floorPlan       String?         // Cloudinary URL

  // Amenities (JSON array)
  amenities       String          @db.Text  // JSON

  // Relations
  construction    Construction    @relation(fields: [constructionId], references: [id])
  constructionId  String
  units           ProjectUnit[]

  // Admin
  isVerified      Boolean         @default(false)
  isFeatured      Boolean         @default(false)
  viewCount       Int             @default(0)
  listingStatus   ListingStatus   @default(PENDING)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model ProjectImage {
  id        String           @id @default(cuid())
  url       String
  caption   String?
  isPrimary Boolean          @default(false)
  project   DeveloperProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
}

model ProjectUnit {
  id          String           @id @default(cuid())
  unitType    String           // "2 Bed", "3 Bed", "Studio"
  floor       Int?
  size        Float            // sqft
  price       Decimal          @db.Decimal(12, 2)
  status      UnitStatus       @default(AVAILABLE)
  project     DeveloperProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  createdAt   DateTime         @default(now())
}

enum ProjectType {
  RESIDENTIAL   // আবাসিক
  COMMERCIAL    // বাণিজ্যিক
  MIXED         // মিশ্র
}

enum ProjectStatus {
  UPCOMING      // শীঘ্রই আসছে
  ONGOING       // নির্মাণাধীন
  READY         // রেডি টু মুভ
  COMPLETED     // সম্পন্ন
}

enum UnitStatus {
  AVAILABLE     // পাওয়া যাচ্ছে
  BOOKED        // বায়না হয়েছে
  SOLD          // বিক্রিত
}

model PortfolioItem {
  id             String       @id @default(cuid())
  title          String
  imageUrl       String
  construction   Construction @relation(fields: [constructionId], references: [id], onDelete: Cascade)
  constructionId String
}

// ─── REVIEWS ───────────────────────────────────

model Review {
  id             String       @id @default(cuid())
  rating         Int          // 1-5
  comment        String?      @db.Text
  reviewer       User         @relation(fields: [reviewerId], references: [id])
  reviewerId     String
  construction   Construction? @relation(fields: [constructionId], references: [id])
  constructionId String?
  createdAt      DateTime     @default(now())
}

// ─── SAVED LISTINGS ────────────────────────────

model SavedListing {
  id        String  @id @default(cuid())
  user      User    @relation(fields: [userId], references: [id])
  userId    String
  listing   Listing @relation(fields: [listingId], references: [id])
  listingId String
  savedAt   DateTime @default(now())

  @@unique([userId, listingId])
}

// ─── LEAD UNLOCK ───────────────────────────────

model LeadUnlock {
  id             String       @id @default(cuid())
  user           User         @relation(fields: [userId], references: [id])
  userId         String
  listing        Listing?     @relation(fields: [listingId], references: [id])
  listingId      String?
  vehicle        Vehicle?     @relation(fields: [vehicleId], references: [id])
  vehicleId      String?
  construction   Construction? @relation(fields: [constructionId], references: [id])
  constructionId String?
  amountPaid     Decimal      @db.Decimal(8, 2)
  paidAt         DateTime     @default(now())
}

// ─── SUBSCRIPTION (BROKER/BUILDER) ─────────────

model Subscription {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id])
  userId    String           @unique
  plan      SubscriptionPlan
  startDate DateTime
  endDate   DateTime
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
}

enum SubscriptionPlan {
  BASIC
  PRO
  ENTERPRISE
}

// ─── FEATURED LISTING AUCTION SYSTEM ───────────

model FeaturedListing {
  id              String         @id @default(cuid())

  // Which listing is being featured
  listing         Listing        @relation(fields: [listingId], references: [id])
  listingId       String
  owner           User           @relation(fields: [ownerId], references: [id])
  ownerId         String

  // Bidding / Budget
  bidPerDay       Decimal        @db.Decimal(8, 2)  // daily budget
  totalBudget     Decimal        @db.Decimal(10, 2) // total amount deposited
  budgetSpent     Decimal        @default(0) @db.Decimal(10, 2)

  // Targeting (null = all)
  targetDistrictId Int?          // compete only in this district
  targetType      String?        // FLAT, HOUSE, LAND etc.
  targetPurpose   String?        // SALE or RENT

  // Performance tracking
  impressions     Int            @default(0)  // how many times shown
  clicks          Int            @default(0)  // how many times clicked
  ctr             Float          @default(0)  // click-through rate (auto-calculated)
  relevanceScore  Float          @default(0.5) // 0.0 to 1.0 (quality × ctr)

  // Status
  status          FeaturedStatus @default(ACTIVE)
  startDate       DateTime       @default(now())
  endDate         DateTime?      // null = runs until budget exhausted

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  impressionLogs  ImpressionLog[]
}

enum FeaturedStatus {
  ACTIVE          // running, showing in rotation
  PAUSED          // user paused it
  BUDGET_DONE     // budget fully spent
  EXPIRED         // past endDate
}

// Track every time a listing is shown or clicked
model ImpressionLog {
  id              String          @id @default(cuid())
  listingId       String          // which listing
  featuredId      String?         // if it was a featured slot
  featured        FeaturedListing? @relation(fields: [featuredId], references: [id])
  source          ImpressionSource
  isClick         Boolean         @default(false) // false=view, true=click
  districtId      Int?            // where the search happened
  createdAt       DateTime        @default(now())
}

enum ImpressionSource {
  HOMEPAGE        // homepage featured section
  SEARCH          // search results page
  SIMILAR         // similar listings section
  DIRECT          // direct listing URL
}

// ─── BUILDER / DEVELOPER PROJECTS ──────────────

model Project {
  id              String         @id @default(cuid())
  title           String
  description     String         @db.Text
  projectType     ProjectType    @default(RESIDENTIAL)
  status          ProjectStatus  @default(UPCOMING)

  // Units info
  totalUnits      Int
  availableUnits  Int
  handoverDate    DateTime?

  // Location
  address         String
  district        District       @relation(fields: [districtId], references: [id])
  districtId      Int
  areaName        String?
  mapLat          Float?
  mapLng          Float?

  // Media
  coverImage      String?
  floorPlanImage  String?
  images          ProjectImage[]

  // Unit types (1bed, 2bed, 3bed etc.)
  units           ProjectUnit[]

  // Developer
  developer       User           @relation(fields: [developerId], references: [id])
  developerId     String

  // Stats
  isFeatured      Boolean        @default(false)
  viewCount       Int            @default(0)
  status2         ListingStatus  @default(PENDING)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model ProjectUnit {
  id           String   @id @default(cuid())
  unitType     String   // "১ বেডরুম", "২ বেডরুম", "পেন্টহাউস"
  area         Float    // sqft
  price        Decimal  @db.Decimal(12, 2)
  totalCount   Int
  available    Int
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String
}

model ProjectImage {
  id        String  @id @default(cuid())
  url       String
  caption   String?
  isPrimary Boolean @default(false)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
}

enum ProjectType {
  RESIDENTIAL   // আবাসিক
  COMMERCIAL    // বাণিজ্যিক
  MIXED         // মিশ্র
}

enum ProjectStatus {
  UPCOMING      // আসছে শীঘ্রই
  ONGOING       // নির্মাণ চলছে
  READY         // হস্তান্তরযোগ্য
  SOLD_OUT      // বিক্রি শেষ
}

// ─── DEVELOPER / BUILDER PROJECT ───────────────

model DeveloperProject {
  id              String        @id @default(cuid())

  // Company info
  companyName     String
  companyLogo     String?

  // Project info
  projectName     String
  description     String        @db.Text
  projectType     ProjectType
  status          ProjectStatus @default(ONGOING)

  // Location
  district        District      @relation(fields: [districtId], references: [id])
  districtId      Int
  address         String
  areaName        String?
  mapLat          Float?
  mapLng          Float?

  // Units
  totalUnits      Int
  availableUnits  Int
  minPrice        Decimal       @db.Decimal(12, 2)
  maxPrice        Decimal       @db.Decimal(12, 2)
  minSize         Float?        // sqft
  maxSize         Float?        // sqft

  // Timeline
  startDate       DateTime?
  handoverDate    DateTime?

  // Amenities (JSON array)
  amenities       String        @db.Text

  // Media
  coverImage      String?
  projectImages   ProjectImage[]
  floorPlans      FloorPlan[]

  // Admin
  listingStatus   ListingStatus @default(PENDING)
  isFeatured      Boolean       @default(false)
  viewCount       Int           @default(0)

  owner           User          @relation(fields: [ownerId], references: [id])
  ownerId         String

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model ProjectImage {
  id        String          @id @default(cuid())
  url       String
  caption   String?
  isPrimary Boolean         @default(false)
  project   DeveloperProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
}

model FloorPlan {
  id        String          @id @default(cuid())
  title     String          // "২ বেডরুম - টাইপ A"
  imageUrl  String
  size      Float?          // sqft
  bedrooms  Int?
  bathrooms Int?
  price     Decimal?        @db.Decimal(12, 2)
  project   DeveloperProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
}

enum ProjectType {
  APARTMENT       // ফ্ল্যাট প্রজেক্ট
  COMMERCIAL      // কমার্শিয়াল
  HOUSING_ESTATE  // আবাসিক এলাকা
  VILLA           // ভিলা
  MIXED_USE       // মিশ্র
}

enum ProjectStatus {
  UPCOMING        // আসছে
  ONGOING         // নির্মাণাধীন
  READY           // হস্তান্তর প্রস্তুত
  HANDED_OVER     // হস্তান্তর সম্পন্ন
}

// ─── DEVELOPER / BUILDER PROJECTS ──────────────

model DeveloperProject {
  id              String          @id @default(cuid())
  owner           User            @relation(fields: [ownerId], references: [id])
  ownerId         String

  // Company & Project info
  companyName     String
  projectName     String
  description     String          @db.Text
  coverImage      String?
  images          ProjectImage[]

  // Location
  district        District        @relation(fields: [districtId], references: [id])
  districtId      Int
  areaName        String?
  address         String?
  mapLat          Float?
  mapLng          Float?

  // Project details
  totalUnits      Int
  availableUnits  Int
  projectType     ProjectType     @default(RESIDENTIAL)
  handoverDate    DateTime?
  floorPlan       String?         // image URL
  amenities       String?         @db.Text  // JSON array

  // Pricing
  minPrice        Decimal         @db.Decimal(12, 2)
  maxPrice        Decimal         @db.Decimal(12, 2)
  pricePerSqft    Decimal?        @db.Decimal(8, 2)

  // Status
  status          ListingStatus   @default(PENDING)
  isFeatured      Boolean         @default(false)
  viewCount       Int             @default(0)

  units           ProjectUnit[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

enum ProjectType {
  RESIDENTIAL    // আবাসিক
  COMMERCIAL     // বাণিজ্যিক
  MIXED          // মিশ্র
}

model ProjectImage {
  id        String           @id @default(cuid())
  url       String
  isPrimary Boolean          @default(false)
  project   DeveloperProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
}

model ProjectUnit {
  id          String           @id @default(cuid())
  project     DeveloperProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String

  unitNumber  String           // যেমন: A-101, B-202
  floor       Int
  size        Float            // sqft
  bedrooms    Int?
  bathrooms   Int?
  price       Decimal          @db.Decimal(12, 2)
  facing      String?
  status      UnitStatus       @default(AVAILABLE)

  createdAt   DateTime         @default(now())
}

enum UnitStatus {
  AVAILABLE
  BOOKED
  SOLD
}
